# Copy this file to .env. Never commit .env or real credentials.
# Sandbox and Production use separate Square access tokens, webhook subscriptions,
# and webhook signature keys. Start with Sandbox.

# Square outbound catalog/inventory sync.
SQUARE_ENVIRONMENT=sandbox
SQUARE_SYNC_ENABLED=1
SQUARE_ACCESS_TOKEN=replace-with-your-square-access-token
SQUARE_LOCATION_ID=replace-with-your-square-location-id
SQUARE_API_VERSION=2026-01-22
SQUARE_CURRENCY=USD
SQUARE_DEFAULT_QUANTITY=1

# Square inbound webhook support. Leave disabled until the subscription below is set up.
SQUARE_WEBHOOK_ENABLED=0
SQUARE_WEBHOOK_SIGNATURE_KEY=replace-with-your-square-webhook-signature-key
# Must exactly match the URL configured in Square Developer Console. Do not derive it from the server host.
# Example: https://ASSIGNED-NAME.ngrok-free.app/square_webhook.php
SQUARE_WEBHOOK_NOTIFICATION_URL=https://ASSIGNED-NAME.ngrok-free.app/square_webhook.php
SQUARE_WEBHOOK_MAX_BODY_BYTES=1048576
SQUARE_WEBHOOK_REFUND_STATUS="RETURNED - NEEDS INSPECTION"
