[TEMPLATE]
# Copy this file to .env and fill in your real Square sandbox credentials.
SQUARE_ENVIRONMENT=sandbox
SQUARE_SYNC_ENABLED=1
SQUARE_ACCESS_TOKEN=replace-with-your-square-access-token
SQUARE_LOCATION_ID=replace-with-your-square-location-id
SQUARE_API_VERSION=2026-07-15
SQUARE_CURRENCY=USD
SQUARE_DEFAULT_QUANTITY=1
SQUARE_API_MAX_RETRIES=3
SQUARE_API_TIMEOUT_SECONDS=20
SQUARE_API_CONNECT_TIMEOUT_SECONDS=5

# Square Webhooks
# Found in Square Developer Dashboard > Webhooks > Signature Key
SQUARE_WEBHOOK_SIGNATURE_KEY=replace-with-your-webhook-signature-key
# Must exactly match the HTTPS notification URL configured in Square.
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-domain.com/webhooks/square.php
# Reject signed events older than this replay window.
SQUARE_WEBHOOK_MAX_AGE_SECONDS=259200


# ── QZ Tray signing ───────────────────────────────────────────────
# Exact origin(s) allowed to use the QZ signing/certificate endpoints,
# comma-separated. Example: https://app.example.com or http://127.0.0.1:8765
QZ_ALLOWED_ORIGINS=http://127.0.0.1:8765
